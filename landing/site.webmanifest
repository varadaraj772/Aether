{
  "name": "Aether",
  "short_name": "Aether",
  "description": "Local semantic file search for macOS. Private Spotlight alternative with on-device embeddings.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f1eb",
  "theme_color": "#0e6a62",
  "icons": [
    {
      "src": "./favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "./og-image.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
